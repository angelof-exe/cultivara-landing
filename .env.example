NEXT_PUBLIC_APP_MODE=release_free      # "waitlist" | "release_free" | "saas"
# URL dell'app reale (usato in release_free per registrazione e login)
NEXT_PUBLIC_APP_URL=https://app.cultivara.it
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_service_id
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_template_id
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key

# Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=your_meta_pixel_id

# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-02-01
SANITY_API_READ_TOKEN=sk_viewer_token           # server-only, lettura drafts
SANITY_REVALIDATE_SECRET=random_hex_secret      # firma webhook revalidate
NEXT_PUBLIC_SITE_URL=http://localhost:3000      # usato dal disable-draft redirect
